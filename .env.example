APP_NAME="Register Attendance Management System"
APP_VERSION=1.0.0
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_FAVICON_PATH=favicon.ico

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
# Set both values for production behind an HTTPS reverse proxy.
# TRUSTED_PROXIES=10.0.0.10
# SESSION_SECURE_COOKIE=true

KEYCLOAK_BASE_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REDIRECT_URI="${APP_URL}/auth/keycloak/callback"
# Comma-separated existing RAMS web role names, matching this client's access token roles.
KEYCLOAK_SSO_ROLES=
# Extra protected roles beyond super-admin. Only the privileged list may grant these.
KEYCLOAK_PROTECTED_ROLES=
# Explicitly opt in to super-admin when assignment of that Keycloak client role is restricted.
KEYCLOAK_SSO_PRIVILEGED_ROLES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

ATTENDANCE_REPORT_PDF_MAX_ROWS=2000

# Per-export PHP ceiling in MiB before the container limit is applied.
INVITATION_EXPORT_MEMORY_LIMIT_MB=512

BULK_IMPORT_MAX_UPLOAD_KB=5120
BULK_IMPORT_MAX_ROWS=2000
BULK_IMPORT_TTL_MINUTES=60
